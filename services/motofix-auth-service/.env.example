# Copy this file to .env and fill in values. Never commit your local .env.
# OTP is for login after explicit logout, a new install, or cleared app data.
# It is not for periodic re-authentication.

DATABASE_URL=postgresql://user:password@localhost:5432/motofix_auth
SECRET_KEY=replace-with-a-long-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=87600
ADMIN_TOKEN_EXPIRE_HOURS=8
ENV=development

UPLOAD_DIR=./uploads
PROVIDER_APP_URL=http://127.0.0.1:5173

AT_USERNAME=motofix
AT_API_KEY=

SMTP_USER=
SMTP_PASS=
SMTP_FROM=MOTOFIX <noreply@example.com>

ANTHROPIC_API_KEY=
SEED_ADMIN_PASSWORD=
SEED_MECHANIC_PASSWORD=
