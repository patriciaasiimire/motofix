# ─────────────────────────────────────────────────────────────────────────────
# motofix-mechanic-matching — environment variables
# Copy this file to .env and fill in your values.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string for dispatch attempt history.
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5433/motofix_matching

# ── JWT validation ───────────────────────────────────────────────────────────
# IMPORTANT: Must match the SECRET_KEY used by motofix-auth-service and all
# other services that issue or validate JWT tokens on the platform.
SECRET_KEY=

ALGORITHM=HS256

# ── Mechanic Verification Service ────────────────────────────────────────────
# URL of the motofix-mechanics-service instance.
# The matching service calls this to fetch the list of available verified mechanics.
MECHANICS_SERVICE_URL=http://127.0.0.1:8002

# ── Small-pool launch mode ──────────────────────────────────────────────────
# Normal scoring considers candidates within this maximum distance.
MATCH_MAX_DISTANCE_KM=50
# If normal capability scoring finds no candidates, use the nearest verified and
# available providers in range; capable provider types rank ahead of alternates.
LAUNCH_MODE=false
