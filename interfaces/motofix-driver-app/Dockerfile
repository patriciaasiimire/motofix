# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

COPY package.json package-lock.json* bun.lockb* ./
RUN npm install

# Vite env vars are baked in at build time — pass them as build args
ARG VITE_API_AUTH_URL=http://localhost:8000
ARG VITE_API_REQUESTS_URL=http://localhost:8001
ARG VITE_API_PAYMENTS_URL=http://localhost:8003
ARG VITE_API_DIAGNOSIS_URL=
ARG VITE_API_MATCHING_URL=
ARG VITE_API_MECHANICS_URL=
ARG VITE_API_INSURANCE_URL=
ARG VITE_WS_URL=
ARG VITE_GOOGLE_MAPS_API_KEY=
ARG VITE_PROVIDER_URL=
ARG VITE_FIREBASE_API_KEY=
ARG VITE_FIREBASE_AUTH_DOMAIN=
ARG VITE_FIREBASE_PROJECT_ID=
ARG VITE_FIREBASE_STORAGE_BUCKET=
ARG VITE_FIREBASE_MESSAGING_SENDER_ID=
ARG VITE_FIREBASE_APP_ID=
ARG VITE_FIREBASE_VAPID_KEY=

ENV VITE_API_AUTH_URL=$VITE_API_AUTH_URL
ENV VITE_API_REQUESTS_URL=$VITE_API_REQUESTS_URL
ENV VITE_API_PAYMENTS_URL=$VITE_API_PAYMENTS_URL
ENV VITE_API_DIAGNOSIS_URL=$VITE_API_DIAGNOSIS_URL
ENV VITE_API_MATCHING_URL=$VITE_API_MATCHING_URL
ENV VITE_API_MECHANICS_URL=$VITE_API_MECHANICS_URL
ENV VITE_API_INSURANCE_URL=$VITE_API_INSURANCE_URL
ENV VITE_WS_URL=$VITE_WS_URL
ENV VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY
ENV VITE_PROVIDER_URL=$VITE_PROVIDER_URL
ENV VITE_FIREBASE_API_KEY=$VITE_FIREBASE_API_KEY
ENV VITE_FIREBASE_AUTH_DOMAIN=$VITE_FIREBASE_AUTH_DOMAIN
ENV VITE_FIREBASE_PROJECT_ID=$VITE_FIREBASE_PROJECT_ID
ENV VITE_FIREBASE_STORAGE_BUCKET=$VITE_FIREBASE_STORAGE_BUCKET
ENV VITE_FIREBASE_MESSAGING_SENDER_ID=$VITE_FIREBASE_MESSAGING_SENDER_ID
ENV VITE_FIREBASE_APP_ID=$VITE_FIREBASE_APP_ID
ENV VITE_FIREBASE_VAPID_KEY=$VITE_FIREBASE_VAPID_KEY

COPY . .
RUN npm run build

# ── Stage 2: serve ─────────────────────────────────────────────────────────────
FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
